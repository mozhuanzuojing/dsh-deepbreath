{
  "name": "dsh-deepbreath",
  "version": "0.12.0",
  "description": "A DeepSeek Harness (DSH) session-view plugin for a short guided breathing break (practice + stats).",
  "keywords": ["dsh", "deepseek-harness", "dsh-plugin", "plugin", "breathing", "mindfulness", "qigong"],
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "docs", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
